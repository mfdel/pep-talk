# Copy to .env (gitignored) and fill in. A variable set in your shell wins over this file.

# Required to render audio. Create a key at https://elevenlabs.io/app/settings/api-keys (Text to Speech permission).
ELEVENLABS_API_KEY=

# Optional voice. Copy an id from https://elevenlabs.io/app/voice-library; blank means the premade voice "George".
ELEVENLABS_VOICE_ID=

# Optional Telegram delivery. Talk to @BotFather in Telegram, send /newbot, and paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# Your chat with the bot: send it /start, then read message.chat.id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=
